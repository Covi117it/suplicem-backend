# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin / Auth Configuration
FIREBASE_PROJECT_ID=suplicem-dev
FIREBASE_STORAGE_BUCKET=suplicem-dev.firebasestorage.app
FIREBASE_API_KEY=your_firebase_api_key_here
GOOGLE_API_URL=https://identitytoolkit.googleapis.com/v1
SECURE_TOKEN_GOOGLE_API_URL=https://securetoken.googleapis.com/v1

# Emulador local de Firebase Storage (opcional para desarrollo offline)
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Email Service (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Twilio SMS
# Trial: solo se puede enviar a numeros verificados (maximo 5) y puede requerir
# habilitar Republica Dominicana en Messaging > Geo permissions.
# TWILIO_SMS_FROM es el remitente de Twilio; puede ser un numero de EE. UU.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+1XXXXXXXXXX
