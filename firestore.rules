rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Blindar totalmente Firestore contra accesos directos desde SDK de cliente.
    // Todas las operaciones de lectura y escritura son procesadas de forma segura por suplicem-backend (Firebase Admin SDK).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
